{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://future24.eu/schemas/twin-observation-v0.1.json",
  "title": "Capture-Agnostic Twin Observation",
  "type": "object",
  "required": ["observationId", "assetId", "source", "observedAt", "provenance", "evidence"],
  "properties": {
    "observationId": {"type": "string"},
    "assetId": {"type": "string"},
    "source": {"enum": ["photo", "video", "iphone_lidar", "professional_lidar", "navvis", "cad", "pid", "sensor", "mes", "erp", "manual"]},
    "observedAt": {"type": "string", "format": "date-time"},
    "geometry": {"type": "object", "properties": {"position": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}, "accuracyMm": {"type": "number", "minimum": 0}}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "coverage": {"type": "number", "minimum": 0, "maximum": 1},
    "freshnessSeconds": {"type": "integer", "minimum": 0},
    "provenance": {"type": "object", "required": ["producer"], "properties": {"producer": {"type": "string"}, "device": {"type": "string"}, "transformChain": {"type": "array", "items": {"type": "string"}}}},
    "evidence": {"type": "object", "required": ["hash"], "properties": {"uri": {"type": "string"}, "hash": {"type": "string"}}},
    "claims": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}